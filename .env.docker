# ─── Docker Compose Environment Override ──────────────
# Copy this file to .env and replace EVERY placeholder before running docker-compose.
# Compose will refuse to start if any of the required values are missing.
#
#   cp .env.docker .env
#   nano .env

# ─── Postgres credentials (used by docker compose to bootstrap the DB container)
POSTGRES_USER=queueseva
POSTGRES_PASSWORD=queueseva-strong-password-please-change-me
POSTGRES_DB=queueseva

# Application reads this for Prisma. Leave the host as "postgres" so the app
# container resolves it through Docker's internal DNS.
DATABASE_URL=postgresql://queueseva:queueseva-strong-password-please-change-me@postgres:5432/queueseva?schema=public

# JWT Secret — REQUIRED. Min 32 chars in production. Used by both the Next.js app
# and the socket service to sign and verify tokens; they MUST share the same value.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Shared secret used by Next.js API routes when calling the socket service /broadcast
# endpoint. Without this, /broadcast is refused in production. Generate independently
# from JWT_SECRET (do not reuse the JWT secret).
# Generate with: openssl rand -base64 32
SOCKET_BROADCAST_SECRET=

# CORS Origins for the socket service. Production deployments MUST use a comma-separated
# list of explicit origins. Leaving this as "*" allows any browser to connect.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Optional client socket URL. Leave empty to use same-origin (recommended when running
# behind a reverse proxy that routes /socket.io/ to the socket service).
# NEXT_PUBLIC_SOCKET_URL=

# Google Sign-In — optional. Leave blank to disable Google auth entirely.
# Web Client ID from https://console.cloud.google.com/apis/credentials
# Add your production origin to the OAuth client's "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=362595755708-l35p72iuca4nm8jmsklgfkhgpbt8urgi.apps.googleusercontent.com
GOOGLE_CLIENT_ID=362595755708-l35p72iuca4nm8jmsklgfkhgpbt8urgi.apps.googleusercontent.com
