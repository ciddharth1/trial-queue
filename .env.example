# ─── Database (Postgres) ────────────────────────────────
# Connection string for any Postgres host (Neon, Supabase, Vercel Postgres,
# RDS, self-hosted, Docker compose service). The format is:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# For Docker compose (default service name "postgres"):
#   postgresql://queueseva:queueseva@postgres:5432/queueseva?schema=public
DATABASE_URL=

# ─── JWT Secret (REQUIRED) ─────────────────────────────
# Generate with: openssl rand -base64 32
# Must be at least 32 chars in production. The app refuses to start with known
# insecure defaults (e.g. "change-me-in-production").
JWT_SECRET=

# ─── Socket Service ────────────────────────────────────
# Internal URL for Next.js API routes → socket service HTTP calls
# Docker: http://socket-service:3003 | Local: http://localhost:3003
SOCKET_SERVICE_URL=http://localhost:3003

# Shared secret for server-to-server /broadcast calls. Without it, the socket service
# refuses /broadcast in production. Generate independently from JWT_SECRET.
# Generate with: openssl rand -base64 32
SOCKET_BROADCAST_SECRET=

# ─── Socket Service CORS (REQUIRED in production) ──────
# Comma-separated allowlist of origins permitted to connect to the socket service.
# Wildcard "*" is acceptable for local dev only.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ─── Client Socket URL (optional) ──────────────────────
# Leave empty for same-origin (reverse proxy handles /socket.io/ routing).
# Only set if the socket service is on a different domain.
# NEXT_PUBLIC_SOCKET_URL=

# ─── Google Sign-In (optional) ─────────────────────────
# Create an OAuth 2.0 Web Client ID at https://console.cloud.google.com/apis/credentials
# Add your origin to "Authorized JavaScript origins" (e.g. https://app.example.com).
# The same value is read by both the server (verifying ID tokens) and the client
# (rendering the Google button). Setting NEXT_PUBLIC_GOOGLE_CLIENT_ID alone is enough
# unless you choose to rotate the server-side audience separately.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# ─── Server Ports (optional) ───────────────────────────
# PORT=3000          # Next.js (rarely overridden)
# NODE_ENV=development
