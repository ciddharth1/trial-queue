# Database
DATABASE_URL=file:./db/custom.db

# JWT Secret (REQUIRED - used for authentication token signing/verification)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Socket Service (optional - for real-time updates)
SOCKET_SERVICE_URL=http://localhost:3003

# Next.js Socket URL (optional - for z.ai preview environment)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
